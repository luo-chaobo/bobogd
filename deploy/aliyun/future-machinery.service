[Unit]
Description=Future Machinery website
After=network.target

[Service]
Type=simple
User=wljixie
Group=wljixie
WorkingDirectory=/srv/wljixie/website
EnvironmentFile=/etc/wljixie/website.env
ExecStart=/usr/bin/node /srv/wljixie/website/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/wljixie/website/data /srv/wljixie/website/private

[Install]
WantedBy=multi-user.target
