page { background: #f3f6f8; color: #1e2d3b; font-size: 28rpx; }
.page { padding: 32rpx; }
.home-page { padding: 24rpx; }
.profile-page { min-height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.login-brand { font-size: 26rpx; }
.company-footer { margin-top: auto; padding: 32rpx 0 8rpx; color: #8a969f; text-align: center; font-size: 26rpx; }
.hero { background: linear-gradient(135deg, #102335, #1b5160); color: #fff; border-radius: 24rpx; padding: 44rpx 36rpx; }
.brand-hero { position: relative; height: 640rpx; overflow: hidden; border-radius: 28rpx; background: #102635; color: #fff; }
.brand-hero-image { position: absolute; top: 0; width: 1138rpx; height: 640rpx; left: -20rpx; }
.brand-hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.brand-hero-shade { background: linear-gradient(90deg, rgba(16,38,53,.96) 0%, rgba(16,38,53,.78) 52%, rgba(16,38,53,.18) 100%); }
.brand-hero-content { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; padding: 32rpx 32rpx 28rpx; box-sizing: border-box; }
.brand-hero-top, .brand-hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
.brand-hero-top { position: absolute; top: 40rpx; left: 10rpx; }
.brand-hero-logo { width: 282rpx; height: 282rpx; }
.brand-hero .title { max-width: 580rpx; font-size: 54rpx; line-height: 1.18; }
.brand-hero .title text { display: block; }
.brand-hero .subtitle { width: 100%; max-width: none; margin-top: 20rpx; color: #e3eaed; font-size: 24rpx; white-space: nowrap; }
.hero-button { align-self: center; width: 100%; max-width: 360rpx; margin: 28rpx auto 0; box-sizing: border-box; background: #FF672B; color: #102635; }
.promise-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin: 24rpx 0; }
.promise-grid > view { min-width: 0; padding: 24rpx 14rpx; border: 1rpx solid #dce3e6; border-radius: 18rpx; background: #fff; }
.home-page .promise-grid { margin: 16rpx 0; }
.home-page .promise-grid > view { padding: 18rpx 12rpx; }
.promise-value, .promise-label { display: block; }
.promise-value { color: #102635; font-size: 24rpx; font-weight: 700; }
.promise-label { margin-top: 6rpx; color: #607080; font-size: 20rpx; }
.eyebrow { color: #59d3c8; font-size: 22rpx; letter-spacing: 3rpx; }
.title { display: block; font-size: 46rpx; font-weight: 700; margin: 12rpx 0; }
.subtitle { color: #d7e4ea; line-height: 1.7; }
.card { background: #fff; border-radius: 20rpx; margin-top: 24rpx; padding: 28rpx; box-shadow: 0 6rpx 24rpx rgba(17, 41, 58, .08); }
.home-page .card { margin-top: 16rpx; padding: 22rpx; }
.section-title { display: block; font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.home-page .section-title { margin-bottom: 12rpx; }
.primary { background: #0b8b86; color: #fff; border-radius: 12rpx; margin-top: 24rpx; }
.outline { border: 1rpx solid #0b8b86; color: #08746f; background: #fff; border-radius: 12rpx; margin-top: 20rpx; }
.field { border-bottom: 1rpx solid #e4ebef; padding: 20rpx 0; }
.label { color: #516170; font-size: 24rpx; display: block; margin-bottom: 10rpx; }
.muted { color: #72818d; font-size: 24rpx; line-height: 1.7; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.tag { background: #e3f5f3; color: #08746f; border-radius: 999rpx; font-size: 22rpx; padding: 8rpx 16rpx; }
.list-item { padding: 24rpx 0; border-bottom: 1rpx solid #eef2f4; }
.home-page .list-item { padding: 16rpx 0; }
.danger { color: #c24e46; font-size: 24rpx; }
.attachment-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.attachment-actions { display: flex; flex-shrink: 0; align-items: center; gap: 14rpx; }
.attachment-remove { width: 44rpx; height: 44rpx; margin: 0; padding: 0; border: 1rpx solid #c24e46; border-radius: 50%; background: #fff; color: #c24e46; font-size: 32rpx; line-height: 40rpx; }
.attachment-remove::after { border: 0; }
.order-section { padding: 30rpx; }
.process-list { display: flex; flex-direction: column; }
.process-step { display: flex; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eef2f4; }
.process-step:last-child { border-bottom: 0; }
.process-index { display: flex; flex: 0 0 54rpx; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; background: #e3f5f3; color: #08746f; font-size: 22rpx; font-weight: 700; }
.process-content { flex: 1; min-width: 0; }
.process-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.process-name { color: #1e2d3b; font-size: 28rpx; font-weight: 600; }
.process-status { flex-shrink: 0; padding: 6rpx 14rpx; border-radius: 999rpx; background: #edf1f3; color: #607080; font-size: 20rpx; }
.process-status-in_progress { background: #fff1e8; color: #c85522; }
.process-status-completed { background: #e3f5f3; color: #08746f; }
.process-time, .timeline-time { display: block; margin-top: 8rpx; color: #84919b; font-size: 22rpx; }
.progress-timeline { display: flex; flex-direction: column; }
.timeline-item { display: flex; gap: 20rpx; min-height: 110rpx; }
.timeline-rail { position: relative; display: flex; flex: 0 0 20rpx; justify-content: center; }
.timeline-dot { position: relative; z-index: 1; width: 18rpx; height: 18rpx; margin-top: 10rpx; border: 5rpx solid #d8f1ef; border-radius: 50%; background: #0b8b86; box-sizing: border-box; }
.timeline-line { position: absolute; top: 28rpx; bottom: -10rpx; width: 2rpx; background: #dce7e9; }
.timeline-content { flex: 1; min-width: 0; padding-bottom: 26rpx; }
.timeline-title { display: block; color: #1e2d3b; font-size: 28rpx; line-height: 1.55; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 56rpx 32rpx; color: #516170; text-align: center; }
.empty-state-mark { display: flex; flex-direction: column; justify-content: center; gap: 10rpx; width: 84rpx; height: 84rpx; margin-bottom: 8rpx; border-radius: 50%; background: #e8f5f4; }
.empty-state-line { width: 40rpx; height: 5rpx; margin: 0 auto; border-radius: 999rpx; background: #0b8b86; }
.empty-state-line-short { width: 26rpx; }
.empty-state-title { color: #1e2d3b; font-size: 30rpx; font-weight: 600; }
.empty-state-description { max-width: 480rpx; color: #72818d; font-size: 24rpx; line-height: 1.6; }
.empty-state-error { margin-top: 4rpx; }
.order-tabs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin-top: 24rpx; padding: 8rpx; border-radius: 16rpx; background: #e7edef; }
.order-tab { padding: 20rpx; border-radius: 12rpx; color: #607080; text-align: center; }
.order-tab-active { background: #fff; color: #08746f; font-weight: 700; box-shadow: 0 3rpx 12rpx rgba(17, 41, 58, .08); }
.history-filters { display: flex; flex-direction: column; gap: 24rpx; }
.filter-field { display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.filter-label { color: #516170; font-size: 24rpx; font-weight: 600; }
.history-search, .date-filter { width: 100%; min-height: 84rpx; padding: 20rpx 24rpx; border: 1rpx solid #d6e0e4; border-radius: 14rpx; box-sizing: border-box; background: #f8fafb; color: #8a969f; line-height: 42rpx; }
.date-filter-selected { color: #1e2d3b; }
.filter-actions, .history-order-footer { display: flex; align-items: center; gap: 16rpx; }
.filter-actions { margin-top: 4rpx; }
.filter-button { flex: 1; min-width: 0; height: 88rpx; margin: 0; padding: 0 12rpx; font-size: 28rpx; line-height: 88rpx; }
.order-number { font-weight: 600; }
.order-summary { display: block; margin: 10rpx 0; color: #516170; line-height: 1.6; }
.history-order-footer { justify-content: space-between; margin-top: 16rpx; }
.repurchase-button { margin: 0; padding: 0 24rpx; border: 1rpx solid #0b8b86; border-radius: 999rpx; background: #fff; color: #08746f; font-size: 24rpx; line-height: 60rpx; }
.repurchase-button::after { border: 0; }
.original-attachments { margin-top: 20rpx; padding: 20rpx; border-radius: 12rpx; background: #f5f8f9; }
.reuse-row { align-items: flex-start; }
.profile-actions { padding-top: 24rpx; }
.support-entry { position: relative; display: flex; align-items: center; width: 100%; min-height: 112rpx; margin: 0 0 28rpx; padding: 18rpx 24rpx; border-radius: 16rpx; box-sizing: border-box; background: linear-gradient(135deg, #08746f, #0b9a91); color: #fff; box-shadow: 0 10rpx 24rpx rgba(11, 139, 134, .22); line-height: 1.3; }
.support-entry::after { border: 0; }
.support-entry-badge { position: absolute; top: 50%; left: 24rpx; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: rgba(255, 255, 255, .18); color: #fff; font-size: 22rpx; font-weight: 700; transform: translateY(-50%); }
.support-entry-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; padding: 0 78rpx; text-align: center; }
.support-entry-title { color: #fff; font-size: 30rpx; font-weight: 700; }
.support-entry-description { margin-top: 6rpx; color: rgba(255, 255, 255, .84); font-size: 22rpx; }
.support-entry-arrow { position: absolute; top: 50%; right: 24rpx; color: #fff; font-size: 44rpx; font-weight: 300; transform: translateY(-50%); }
