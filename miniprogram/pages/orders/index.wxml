<view class="page"><view class="hero"><text class="eyebrow">MY ORDERS</text><text class="title">我的订单</text><text class="subtitle">只展示可对外公开的订单节点。</text></view><view class="card" wx:if="{{items.length}}"><view wx:for="{{items}}" wx:key="id" class="list-item" bindtap="detail" data-id="{{item.id}}"><view class="row"><text>{{item.orderNumber}}</text><text class="tag">{{item.status}}</text></view><text class="muted">点击查看公开进度</text></view></view><view class="card" wx:else><text class="muted">暂未查询到订单。</text></view></view>
