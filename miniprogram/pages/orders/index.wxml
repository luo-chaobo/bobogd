<view class="page">
  <view class="hero"><text class="eyebrow">MY ORDERS</text><text class="title">我的订单</text><text class="subtitle">查看进行中和已送达的订单。</text></view>
  <view class="order-tabs">
    <view class="order-tab {{scope === 'active' ? 'order-tab-active' : ''}}" data-scope="active" bindtap="switchScope">进行中</view>
    <view class="order-tab {{scope === 'history' ? 'order-tab-active' : ''}}" data-scope="history" bindtap="switchScope">历史订单</view>
  </view>
  <view class="card history-filters" wx:if="{{scope === 'history'}}">
    <view class="filter-field">
      <text class="filter-label">订单号</text>
      <input class="history-search" value="{{keyword}}" bindinput="keyword" placeholder="请输入订单号" confirm-type="search" bindconfirm="search"/>
    </view>
    <view class="filter-field">
      <text class="filter-label">开始日期</text>
      <picker mode="date" bindchange="startDate"><view class="date-filter {{startDate ? 'date-filter-selected' : ''}}">{{startDate || '请选择开始日期'}}</view></picker>
    </view>
    <view class="filter-field">
      <text class="filter-label">结束日期</text>
      <picker mode="date" bindchange="endDate"><view class="date-filter {{endDate ? 'date-filter-selected' : ''}}">{{endDate || '请选择结束日期'}}</view></picker>
    </view>
    <view class="filter-actions"><button class="outline filter-button" bindtap="clearFilters">重置</button><button class="primary filter-button" bindtap="search">查询历史订单</button></view>
  </view>
  <view class="card" wx:if="{{items.length}}">
    <view wx:for="{{items}}" wx:key="id" class="list-item" bindtap="detail" data-id="{{item.id}}">
      <view class="row"><text class="order-number">{{item.orderNumber}}</text><text class="tag">{{item.statusText}}</text></view>
      <text class="order-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
      <text class="muted" wx:if="{{scope === 'active'}}">点击查看公开进度</text>
      <view class="history-order-footer" wx:else>
        <text class="muted">完成日期：{{item.completedDate}}</text>
        <button class="repurchase-button" catchtap="repurchase" data-id="{{item.id}}">再次购买</button>
      </view>
    </view>
    <button class="outline" wx:if="{{items.length < total}}" loading="{{loading}}" bindtap="loadMore">加载更多</button>
  </view>
  <view class="card empty-state" wx:else>
    <view class="empty-state-mark"><view class="empty-state-line"></view><view class="empty-state-line empty-state-line-short"></view></view>
    <text class="empty-state-title" wx:if="{{loading}}">正在加载订单</text>
    <text class="empty-state-title" wx:elif="{{error}}">订单加载失败</text>
    <text class="empty-state-title" wx:elif="{{scope === 'history'}}">暂未查询到历史订单</text>
    <text class="empty-state-title" wx:else>暂无进行中的订单</text>
    <text class="empty-state-description" wx:if="{{!loading && !error}}">{{scope === 'history' ? '可调整订单号或日期范围后重新查询' : '新的正式订单将在这里显示'}}</text>
    <text class="danger empty-state-error" wx:if="{{error}}">{{error}}</text>
  </view>
</view>
