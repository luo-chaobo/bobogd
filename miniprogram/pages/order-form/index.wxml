<view class="page"><view class="hero"><text class="eyebrow">FAST REQUEST</text><text class="title">快速提交加工需求</text><text class="subtitle">有图纸、现场照片或只有尺寸描述都可以。</text></view><view class="card"><view class="field"><text class="label">资料情况</text><picker range="{{drawingModes}}" bindchange="drawingMode"><view>{{form.drawingMode}}</view></picker></view><view class="field"><text class="label">联系人</text><input data-field="contactName" value="{{form.contactName}}" bindinput="input" placeholder="姓名或称呼"/></view><view class="field"><text class="label">手机号</text><input data-field="phone" value="{{form.phone}}" bindinput="input" type="number" placeholder="用于联系和订单查询"/></view><view class="field"><text class="label">所在区域</text><input data-field="region" value="{{form.region}}" bindinput="input" placeholder="城市/区县"/></view><view class="field"><text class="label">数量</text><input data-field="quantity" value="{{form.quantity}}" bindinput="input" type="number"/></view><view class="field"><text class="label">期望交期</text><picker mode="date" bindchange="expectedDate"><view>{{form.expectedDate || '请选择日期'}}</view></picker></view><view class="field"><text class="label">加工需求</text><textarea data-field="description" value="{{form.description}}" bindinput="input" placeholder="材料、尺寸、用途、表面要求等"/></view><view class="field"><text class="label">材料（选填）</text><input data-field="material" value="{{form.material}}" bindinput="input"/></view><view class="field"><text class="label">尺寸（选填）</text><input data-field="dimensions" value="{{form.dimensions}}" bindinput="input"/></view><button class="outline" bindtap="chooseImages">选择现场照片</button><button class="outline" bindtap="chooseFiles">选择图纸/多个附件</button><view wx:for="{{attachments}}" wx:key="path" class="list-item row"><text>{{item.name}}</text><text class="muted">{{item.size}} B</text></view><text class="danger" wx:if="{{error}}">{{error}}</text><button class="outline" bindtap="saveDraft">保存草稿</button><button class="primary" loading="{{submitting}}" bindtap="submit">提交需求</button></view></view>
