<view class="page"><view class="hero"><text class="eyebrow">ORDER TRACKING</text><text class="title">{{order.orderNumber || '订单详情'}}</text><text class="subtitle">{{order.status || '正在查询公开节点'}}</text></view><view class="card"><text class="section-title">公开进度</text><view wx:for="{{order.events}}" wx:key="occurredAt" class="list-item"><text>{{item.title}}</text><text class="muted">{{item.occurredAt}}</text></view><text class="muted" wx:if="{{!order.events.length}}">暂无可公开的生产节点。</text></view></view>
