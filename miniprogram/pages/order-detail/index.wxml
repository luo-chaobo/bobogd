<view class="page order-detail-page">
  <view class="hero">
    <view class="order-hero-copy"><text class="eyebrow">ORDER TRACKING</text><view class="order-number-title"><text class="title order-number-line">{{order.orderNumberPrefix || '订单详情'}}</text><text wx:if="{{order.orderNumberSuffix}}" class="title order-number-line">{{order.orderNumberSuffix}}</text></view><text class="subtitle">{{order.statusText || '正在查询公开节点'}}</text></view>
    <view class="delivery-date delivery-date-{{order.deliveryDateTone}}"><text>{{order.deliveryDateText || '交期待确认'}}</text></view>
  </view>

  <view class="card order-section">
    <text class="section-title">生产工序</text>
    <view class="process-list" wx:if="{{order.processes.length}}">
      <view wx:for="{{order.processes}}" wx:key="id" class="process-step">
        <view class="process-index">{{item.sequenceText}}</view>
        <view class="process-content">
          <view class="process-heading"><text class="process-name">{{item.name}}</text><text class="process-status process-status-{{item.statusKey}}">{{item.statusText}}</text></view>
          <text class="process-time">{{item.displayTime}}</text>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else><text>工序待生产主管安排</text><text class="muted">排产或报工后将在这里同步更新。</text></view>
  </view>

  <view class="card order-section">
    <view class="section-heading"><text class="section-title">公开进度</text><view class="refresh-control"><text class="refresh-time">更新于 {{lastUpdated || '--:--:--'}}</text><button class="refresh-button" loading="{{refreshing}}" bindtap="refreshNow">刷新</button></view></view>
    <view class="progress-timeline" wx:if="{{order.events.length}}">
      <view wx:for="{{order.events}}" wx:key="occurredAt" class="timeline-item">
        <view class="timeline-rail"><view class="timeline-dot"></view><view class="timeline-line" wx:if="{{index < order.events.length - 1}}"></view></view>
        <view class="timeline-content"><text class="timeline-title">{{item.title}}</text><text class="timeline-time">{{item.displayTime}}</text></view>
      </view>
    </view>
    <view class="empty-state" wx:else><text>暂无可公开的生产节点</text><text class="muted">新节点确认后会自动显示。</text></view>
  </view>
</view>
